# Node and deterministic web build output
node_modules/
dist/
assets/vendor/
assets/generated/
npm-debug.log*

# Local Word document workspace (仅挡 Word 临时稿，不忽略架构/协作文档)
docs/*.docx
docs/*.doc
docs/*.tmp
docs/~$*
DEVELOPMENT_GUIDE.md

# Local Android and Gradle state (the android project itself will be tracked)
.toolchains/
android/.gradle/
android/local.properties
android/**/build/
debug_apk/
release_apk/

# Raw device benchmark captures and DevTools traces (commit summaries only)
benchmark-results/raw/
benchmark-results/traces/

# Release signing secrets
*.keystore
*.jks
keystore.properties

# Local agent/editor tooling (machine-specific)
.codegraph/
.omo/
.codex/
.opencode/
opencode.jsonc
