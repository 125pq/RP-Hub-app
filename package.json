{
  "name": "rp-hub-app",
  "version": "1.8.2",
  "private": true,
  "scripts": {
    "prepare:vendor": "node scripts/prepare-vendor.mjs",
    "build:css": "node scripts/build-css.mjs",
    "build:web": "npm run prepare:vendor && npm run build:css && node scripts/build-web.mjs",
    "verify:dist": "node scripts/verify-dist.mjs",
    "test:syntax": "node --check assets/js/platform-services.js && node --check assets/js/rphub-android-adapter.js && node --check assets/js/core-utils.js && node --check assets/js/app.js",
    "test:platform": "npm run test:syntax && node scripts/test-platform-services.mjs && node scripts/test-safe-area-layout.mjs",
    "test:upstream-sync": "node scripts/upstream-sync/tests/release-source.mjs && node scripts/upstream-sync/verify.mjs && node scripts/upstream-sync/tests/reapply-idempotence.mjs",
    "test:performance": "node scripts/test-performance-benchmark.mjs && node scripts/test-offscreen-iframe-lifecycle.mjs && node scripts/test-streaming-flush.mjs",
    "sync:upstream": "node scripts/upstream-sync/sync-upstream.mjs",
    "sync:upstream:dry-run": "node scripts/upstream-sync/sync-upstream.mjs --dry-run",
    "android:sync": "npm run build:web && npx cap sync android",
    "android:debug": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android-debug.ps1",
    "android:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android-release.ps1",
    "android:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "7.6.8",
    "@capacitor/app": "7.1.2",
    "@capacitor/browser": "7.0.5",
    "@capacitor/core": "7.6.8",
    "@capacitor/share": "7.0.4",
    "@fontsource-variable/lora": "5.2.8",
    "@fontsource/ma-shan-zheng": "5.2.8",
    "@fontsource/noto-serif-sc": "5.2.8",
    "@mhsdesign/jit-browser-tailwindcss": "0.4.2",
    "daisyui": "4.12.24",
    "dompurify": "3.4.13",
    "jquery": "3.7.1",
    "localforage": "1.10.0",
    "marked": "15.0.12",
    "sortablejs": "1.15.6",
    "tailwindcss": "3.4.17",
    "vue": "3.5.18"
  },
  "devDependencies": {
    "@capacitor/cli": "7.6.8"
  }
}
